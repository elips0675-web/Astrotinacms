---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  subtitle?: string;
  actionHref?: string;
  actionLabel?: string;
  actionIcon?: string;
}

const { title, subtitle, actionHref, actionLabel, actionIcon = 'plus' } = Astro.props;
---

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase italic">{title}</h1>
    {subtitle && <p class="text-muted-foreground text-[10px] font-bold uppercase tracking-widest mt-1">{subtitle}</p>}
  </div>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="bg-primary hover:bg-primary/90 text-white rounded-xl h-12 px-6 font-black uppercase text-[10px] tracking-widest flex items-center transition-all active:scale-95"
      >
        <Icon name={actionIcon} class="mr-2 h-4 w-4" />
        {actionLabel}
      </a>
    )
  }
</div>