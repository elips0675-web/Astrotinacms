---
import Icon from './Icon.astro';

export interface Props {
  placeholder?: string;
}

const { placeholder = 'Поиск...' } = Astro.props;
---

<div class="flex items-center gap-4 bg-white p-4 rounded-xl border border-slate-100 shadow-sm">
  <div class="relative flex-1">
    <Icon name="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400" />
    <input
      type="search"
      placeholder={placeholder}
      aria-label={placeholder}
      class="pl-10 h-10 w-full border-none bg-slate-50 font-bold text-xs rounded-lg outline-none focus-visible:ring-1 focus-visible:ring-primary"
    />
  </div>
</div>