---
import Icon from './Icon.astro';
import type { WPEvent, WPPrintItem, WPService } from '../data/mock';

export interface Props {
  kind: 'services' | 'printing-services' | 'events';
  entity?: WPService | WPPrintItem | WPEvent;
}

const { kind, entity } = Astro.props;

const labels: Record<string, string> = {
  services: { back: '/admin/services', title: 'услугу', subtitle: 'Название, описание и цена', create: 'Создать услугу' },
  'printing-services': {
    back: '/admin/printing-services',
    title: 'позицию',
    subtitle: 'Полиграфия, формат и цена',
    create: 'Создать позицию',
  },
  events: { back: '/admin/events', title: 'событие', subtitle: 'Дата, время и место проведения', create: 'Создать событие' },
};

const config = labels[kind];
const item = entity as Record<string, string> | undefined;

const fieldClass =
  'w-full h-12 rounded-xl bg-slate-50 border-slate-200 px-4 font-bold text-sm text-slate-900 outline-none focus-visible:ring-1 focus-visible:ring-primary';
const labelClass = 'block text-[10px] font-black uppercase tracking-[0.2em] text-primary ml-1 mb-2';
---

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a
        href={config.back}
        class="h-10 w-10 rounded-xl inline-flex items-center justify-center hover:bg-slate-100 text-slate-500"
        aria-label="Назад"
      >
        <Icon name="chevronLeft" class="h-5 w-5" />
      </a>
      <div>
        <h1 class="text-2xl font-black text-slate-800 uppercase italic">
          {entity ? `Редактировать ${config.title}` : `Новая ${config.title}`}
        </h1>
        <p class="text-muted-foreground text-[10px] font-bold uppercase tracking-widest mt-1">{config.subtitle}</p>
      </div>
    </div>

    <button
      type="submit"
      form="entity-form"
      class="h-12 px-8 rounded-xl bg-primary hover:bg-primary/90 text-white font-black text-[10px] uppercase tracking-widest flex items-center"
    >
      <Icon name="save" class="mr-2 h-4 w-4" />
      {entity ? 'Обновить' : config.create}
    </button>
  </div>

  <form id="entity-form" method="post" class="bg-white rounded-2xl border border-slate-100 shadow-sm p-10 space-y-8">
    <div>
      <label class={labelClass} for="title">Название</label>
      <input
        id="title"
        name="title"
        type="text"
        placeholder={kind === 'events' ? 'Например: Мастер-класс' : 'Например: Веб-разработка'}
        value={item?.title}
        required
        class={fieldClass}
      />
    </div>

    <div>
      <label class={labelClass} for="description">Описание</label>
      <textarea
        id="description"
        name="description"
        placeholder="Краткое описание"
        class="w-full h-28 rounded-xl bg-slate-50 border-slate-200 p-4 font-bold text-sm text-slate-900 outline-none focus-visible:ring-1 focus-visible:ring-primary"
      >{item?.description}</textarea>
    </div>

    {
      kind === 'events' ? (
        <>
          <div class="grid gap-8 md:grid-cols-3">
            <div>
              <label class={labelClass} for="date">
                Дата
              </label>
              <input id="date" name="date" type="date" value={item?.date} class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="time">
                Время
              </label>
              <input id="time" name="time" type="time" value={item?.time} class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="location">
                Место
              </label>
              <input id="location" name="location" type="text" value={item?.location} class={fieldClass} />
            </div>
          </div>

          <div class="max-w-xs">
            <label class={labelClass} for="status">
              Статус
            </label>
            <select id="status" name="status" class={fieldClass}>
              <option value="upcoming" selected={item?.status === 'upcoming'}>Предстоит</option>
              <option value="past" selected={item?.status === 'past'}>Прошло</option>
              <option value="cancelled" selected={item?.status === 'cancelled'}>Отменено</option>
            </select>
          </div>
        </>
      ) : (
        <div class="grid gap-8 md:grid-cols-3">
          {kind === 'printing-services' && (
            <div>
              <label class={labelClass} for="format">
                Формат
              </label>
              <input id="format" name="format" type="text" placeholder="85x55mm" value={item?.format} class={fieldClass} />
            </div>
          )}
          <div>
            <label class={labelClass} for="price">Цена</label>
            <input
              id="price"
              name="price"
              type="text"
              placeholder="от $999"
              value={item?.price}
              class={fieldClass}
            />
          </div>
          <div>
            <label class={labelClass} for="status">Статус</label>
            <select id="status" name="status" class={fieldClass}>
              <option value="active" selected={item?.status === 'active'}>Активна</option>
              <option value="inactive" selected={item?.status === 'inactive'}>Скрыта</option>
            </select>
          </div>
        </div>
      )
    }

    <div class="flex justify-end pt-4 border-t">
      <button
        type="submit"
        class="h-14 px-10 rounded-2xl bg-primary hover:bg-primary/90 text-white font-black text-[10px] uppercase tracking-[0.2em] transition-all active:scale-95"
      >
        {entity ? 'Обновить' : config.create}
      </button>
    </div>
  </form>
</div>