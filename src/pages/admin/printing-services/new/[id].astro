---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminShell from '../../../../components/AdminShell.astro';
import EntityEditor from '../../../../components/EntityEditor.astro';
import { MOCK_PRINTING } from '../../../../data/mock';
import type { WPPrintItem } from '../../../../data/mock';

export function getStaticPaths() {
  return MOCK_PRINTING.map((item) => ({ params: { id: String(item.id) }, props: { entity: item } }));
}

interface Props {
  entity: WPPrintItem;
}

const { entity } = Astro.props;
---

<AdminLayout title={`${entity.title} — SuperPanel`}>
  <AdminShell>
    <EntityEditor kind="printing-services" entity={entity} />
  </AdminShell>
</AdminLayout>