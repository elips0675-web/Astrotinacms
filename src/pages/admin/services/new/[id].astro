---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminShell from '../../../../components/AdminShell.astro';
import EntityEditor from '../../../../components/EntityEditor.astro';
import { MOCK_SERVICES } from '../../../../data/mock';
import type { WPService } from '../../../../data/mock';

export function getStaticPaths() {
  return MOCK_SERVICES.map((service) => ({ params: { id: String(service.id) }, props: { entity: service } }));
}

interface Props {
  entity: WPService;
}

const { entity } = Astro.props;
---

<AdminLayout title={`${entity.title} — SuperPanel`}>
  <AdminShell>
    <EntityEditor kind="services" entity={entity} />
  </AdminShell>
</AdminLayout>